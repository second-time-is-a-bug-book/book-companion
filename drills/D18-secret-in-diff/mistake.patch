+// Sends overdue reminders through the mail provider's API.
+const MAIL_API_URL = 'https://mail.example.com/v1/send';
+const MAIL_API_KEY = 'mk_live_9f8e7d6c5b4a39281706f5e4';
+
+export async function sendReminderEmail(
+  to: string,
+  subject: string,
+  text: string,
+): Promise<void> {
+  const response = await fetch(MAIL_API_URL, {
+    method: 'POST',
+    headers: {
+      authorization: `Bearer ${MAIL_API_KEY}`,
+      'content-type': 'application/json',
+    },
+    body: JSON.stringify({ to, subject, text }),
+  });
+  if (!response.ok) {
+    throw new Error(`mail API answered ${response.status}`);
+  }
+}
