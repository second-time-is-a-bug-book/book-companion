+
+// The one-line text of a reminder email.
+export function reminderText(
+  reminder: Reminder,
+  totalCents: number,
+): string {
+  const total = formatCents(totalCents);
+  const days = reminder.daysOverdue;
+  return `Invoice ${reminder.invoiceNumber} for ${total} is ` +
+    `${days} days overdue.`;
+}
