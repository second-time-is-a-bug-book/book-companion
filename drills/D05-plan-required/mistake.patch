+// A fixed discount comes off the total after tax, and never
+// below zero.
+export function applyDiscount(
+  totals: Totals,
+  discountCents: Cents,
+): Totals {
+  const discount = Math.min(discountCents, totals.totalCents);
+  const totalCents = totals.totalCents - discount;
+  return { ...totals, totalCents };
+}
