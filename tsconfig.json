{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "app/**/*.ts",
    "guards/**/*.ts",
    "toy-agent/**/*.ts",
    "drills/**/*.ts",
    "experiment/**/*.ts",
    "legacy/characterisation/**/*.ts",
    "playwright.config.ts"
  ]
}
